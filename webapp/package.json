{
  "name": "name-tag-webapp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-based name-tag to multicolor 3MF generator (Waltograph-ready, GitHub Pages).",
  "scripts": {
    "fonts": "node scripts/download-fonts.mjs",
